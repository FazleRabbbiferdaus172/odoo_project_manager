<?xml version="1.0" encoding="UTF-8"?>
<module type="PYTHON_MODULE" version="4">
  <component name="NewModuleRootManager">
    <content url="file://$MODULE_DIR$/{{ relative_conf_path }}">
      <excludeFolder url="file://$MODULE_DIR$/{{ relative_conf_path }}" />
    </content>
    <content url="file://$MODULE_DIR$/{{ relative_odoo_community_path }}">
      <sourceFolder url="file://$MODULE_DIR$/{{ relative_odoo_community_path }}" isTestSource="false" />
    </content>
    <content url="file://$MODULE_DIR$/{{ relative_odoo_enterprise_path }}">
      <sourceFolder url="file://$MODULE_DIR$/{{ relative_odoo_enterprise_path }}/enterprise" isTestSource="false" />
    </content>
    <content url="file://$MODULE_DIR$">
      <excludeFolder url="file://$MODULE_DIR$/.venv" />
    </content>
    <orderEntry type="jdk" jdkName="{{ jdk_name }}" jdkType="Python SDK" />
    <orderEntry type="sourceFolder" forTests="false" />
  </component>
</module>
